# Copy to .env (gitignored) and fill in as needed. All values are optional.

# AbuseIPDB key for live IP reputation. Empty = deterministic mock mode.
ABUSEIPDB_API_KEY=
# Alert webhook (e.g. Slack/Teams incoming webhook). Empty = /data/webhook_outbox.jsonl.
WEBHOOK_URL=
# Shared X-API-Key for the engine API; the dashboard and simulator send it too.
# Empty = no authentication. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SENTINEL_API_KEY=

# Attack simulator traffic.
SIM_SEED=1337
SIM_RATE=20
SIM_ATTACK_RATIO=0.1
